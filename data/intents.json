{
  "intents": [
    {
      "tag": "greeting",
      "patterns": ["Hi", "Hello", "Hey", "Good morning", "What's up"],
      "responses": ["Hello!", "Hi there!", "Greetings!"]
    },
    {
      "tag": "goodbye",
      "patterns": ["Bye", "See you later", "Goodbye", "Catch you later"],
      "responses": ["Goodbye!", "Take care!", "See you soon!"]
    },
    {
      "tag": "thanks",
      "patterns": ["Thanks", "Thank you", "Much appreciated"],
      "responses": ["You're welcome!", "Glad I could help!", "Anytime!"]
    },
    {
      "tag": "age",
      "patterns": ["How old are you?", "What's your age?", "Tell me your age"],
      "responses": ["I'm a chatbot, age doesn't apply!", "I was created recently!"]
    },
    {
      "tag": "name",
      "patterns": ["What's your name?", "Who are you?", "Your name?"],
      "responses": ["I'm your friendly chatbot!", "I don't have a name yet. Want to name me?"]
    }
  ]
}
